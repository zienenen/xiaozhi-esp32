DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

POSTGRES_DB=blindbox
POSTGRES_USER=blindbox
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT=5

# seed_demo hashes this credential. API responses and logs must never expose it.
DEMO_DEVICE_TOKEN=replace-with-device-token
XIAOZHI_TOOL_TOKEN=replace-with-tool-service-token

DEMO_ADMIN_USERNAME=demo_admin
DEMO_ADMIN_PASSWORD=replace-with-demo-password
